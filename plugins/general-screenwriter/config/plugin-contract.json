{
  "schema_version": 1,
  "entry_skill": "general-screenwriter",
  "type_registry": "config/type-packs.json",
  "creative_context": {
    "schema_version": "screenwriter-context-v1",
    "medium_ids": [
      "picturebook",
      "shortdrama",
      "tv_longform"
    ],
    "scope_levels": [
      "global",
      "medium",
      "genre",
      "series",
      "project",
      "season",
      "episode",
      "scene",
      "task"
    ],
    "legacy_default_medium": "picturebook"
  },
  "compatibility": {
    "legacy_entry_skill": "picturebook-screenwriter",
    "legacy_run_schema": "pb-stage-run-v2",
    "legacy_task_schema": "pb-stage-task-v1",
    "legacy_knowledge_key_shape": "series_id/project_id/page_type"
  },
  "skills": [
    "general-screenwriter",
    "text-craft",
    "craft-benchmark-check",
    "staging-planner",
    "stage-orchestration",
    "wiki-ingest",
    "feishu-knowledge-store",
    "knowledge-loader",
    "lexile-check",
    "story-planning",
    "pre_create-baseline",
    "in_create-baseline",
    "post_create-baseline",
    "pre_output-baseline",
    "quality-baseline",
    "image-prompt-architect",
    "image-generate",
    "illustration-export",
    "session-export",
    "user-skill-hub"
  ],
  "intents": [
    "creation",
    "revision",
    "review",
    "knowledge",
    "illustration"
  ],
  "artifact_types": [
    "positioning",
    "topic_plan",
    "worldview",
    "characters",
    "outline",
    "script",
    "illustration_prompt_payload",
    "image_asset",
    "asset_registry",
    "html_preview"
  ],
  "workflow_states": [
    "briefing",
    "knowledge_loading",
    "drafting",
    "self_review",
    "quality_review",
    "confirmation",
    "approved",
    "exported",
    "rejected"
  ],
  "creative_pipeline": {
    "resolver": "skills/general-screenwriter/scripts/slot_resolver.py",
    "slots": [
      "pre_create",
      "in_create",
      "post_create",
      "pre_output",
      "quality"
    ],
    "default_tier": "baseline",
    "slot_skills": {
      "pre_create": "pre_create-baseline",
      "in_create": "in_create-baseline",
      "post_create": "post_create-baseline",
      "pre_output": "pre_output-baseline",
      "quality": "quality-baseline"
    },
    "lightweight_mode": {
      "skill": "story-planning",
      "trigger": "explicit_user_request",
      "write_policy": "dialog_only"
    }
  },
  "quality_gate": {
    "confirmation_package": [
      "draft",
      "metrics",
      "findings",
      "blocked_reasons"
    ],
    "project_authority": "FAIL_blocks_confirmation",
    "craft_benchmark": "FAIL_requires_user_confirmation",
    "wiki_lint": "read_only",
    "lexile_check": "optional_measured_only"
  },
  "stage_workflow": {
    "run_schema": "pb-stage-run-v2",
    "runtime_source": "scripts/stage_dag.py"
  },
  "illustration_route": {
    "sequence": [
      "staging-planner",
      "image-prompt-architect",
      "image-generate",
      "illustration-export"
    ],
    "confirmation_gate": "before_image_generation",
    "explicit_choices": [
      "output_directory",
      "size",
      "quality"
    ]
  },
  "image_generation": {
    "api_key_sources": [
      "explicit_cli_argument",
      "GENERAL_SCREENWRITER_SFACAI_KEY",
      "PICTUREBOOK_SFACAI_KEY"
    ],
    "key_logging": "forbidden",
    "default_api_call": "forbidden",
    "missing_references": "error"
  },
  "html_export": {
    "self_contained": true,
    "model_calls": "forbidden",
    "external_resources": "forbidden",
    "embed_required_args": [
      "limit_mb",
      "quality"
    ],
    "over_limit": "fail_closed"
  },
  "write_policy": {
    "default": "dialog_only",
    "allowed_write_triggers": [
      "user_approves_confirmation_gate",
      "user_explicitly_requests_export"
    ],
    "forbidden_write_triggers": [
      "workflow_finished",
      "quality_gate_passed",
      "cache_available",
      "plugin_maintenance"
    ]
  },
  "unsupported_workbuddy_capabilities": [
    "TeamCreate",
    "SendMessage",
    "native_workbuddy_hooks",
    "multi_subagent_team_runtime",
    "workbuddy_local_library"
  ],
  "type_pack_contract": {
    "schema_version": "type-pack-contract-v1",
    "active_medium_ids": [
      "picturebook",
      "shortdrama",
      "tv_longform"
    ],
    "planned_medium_ids": [
    ],
    "core_artifact_ids": [
      "positioning",
      "topic_plan",
      "worldview",
      "characters",
      "outline",
      "script"
    ],
    "optional_workflows": {
      "illustration": {
        "required": false,
        "blocks_core_completion": false,
        "input": {
          "artifact_id": "script",
          "required_status": "approved"
        },
        "artifact_ids": [
          "asset_registry",
          "illustration_prompt_payload",
          "image_asset",
          "html_preview"
        ]
      }
    }
  },
  "creative_workflow": {
    "schema_version": "creative-workflow-v1",
    "run_builder": "scripts/creative_run_builder.py",
    "runtime_source": "scripts/stage_dag.py",
    "explicit_context_runs": "type_pack_resolved",
    "legacy_no_context_runs": "picturebook_compatible",
    "planned_medium_ids": []
  },
  "quality_gate_contract": {
    "schema_version": "quality-gate-v1",
    "blocking_policies": [
      "hard_block",
      "require_user_confirmation",
      "advisory",
      "informational"
    ],
    "result_statuses": [
      "pass",
      "warn",
      "fail",
      "skipped",
      "unknown"
    ],
    "executes_validators": false,
    "confirmation_role": "report_only"
  },
  "user_skill_contract": {
    "schema_version": "user-skill-contract-v1",
    "skill_types": [
      "prompt_skill",
      "checklist_skill",
      "validator_skill",
      "exporter_skill"
    ],
    "execution_policies": [
      "dialog_only",
      "advisory",
      "blocking_validator",
      "export_only",
      "interactive"
    ],
    "statuses": [
      "draft",
      "active",
      "disabled",
      "retired"
    ],
    "registry_example": "config/user-skills.example.json",
    "cannot_replace_system_rules": true
  },
  "user_skill_hub": {
    "schema_version": "user-skill-hub-v1",
    "all_token": "all",
    "required_user_field": "user_name",
    "skill_types": [
      "prompt_skill",
      "checklist_skill",
      "reference_skill",
      "exporter_skill"
    ],
    "allow_executable_files": false
  },
  "picturebook_migration": {
    "text_core_status": "migrated",
    "illustration_workflow_status": "migrated",
    "knowledge_adapter_status": "v1_compatible",
    "legacy_aliases": [
      "picturebook-screenwriter",
      "pb-stage-run-v2",
      "pb-stage-task-v1",
      "pb-screenwriter",
      "illustration-template"
    ]
  },
  "release_gate": {
    "schema_version": "release-gate-v1",
    "script": "scripts/release_gate.py",
    "migration_report": "scripts/migration_report.py",
    "steps": [
      "registry_contract",
      "knowledge_adapter",
      "skill_registry",
      "dag_scheduler",
      "quality_gate",
      "exporter_contract",
      "offline_regression",
      "governance_check",
      "packaging_check"
    ]
  }
}
